generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Preview since 7.4.0: lets @@unique take `where`. Re-test on any Prisma upgrade.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Auth tables follow Better Auth 1.7.15's core schema. The Prisma adapter reaches them as
// prisma.user, prisma.session, ... and checks them at runtime, so keep these models and the
// additionalFields in features/auth/server/auth.ts in step.

model User {
  id            String    @id // set in the user.create.before hook: 32 letters and digits
  name          String // "" for magic-link sign-ups until a profile step exists
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  nexconnUserId String?   @unique // equals id; written in the same INSERT
  language      String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  lecturesCreated    Lecture[]
  lectureMemberships LectureMembership[]
  moments            Moment[]           @relation("MomentAuthor")
  pinnedMoments      Moment[]           @relation("MomentPinnedBy")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum Visibility {
  public
  private
}

enum Role {
  member
  answerer
  host
}

model Lecture {
  id                  String              @id // 32 letters and digits, like User.id
  youtubeId           String // case-sensitive; format enforced by the parser
  title               String // from YouTube oEmbed, never from the client
  channelName         String
  durationSec         Int? // unknown until a trusted source exists
  metaFetchedAt       DateTime            @default(now()) // YouTube policy: refresh within 30 days
  nexconnChannelId    String              @unique
  nexconnGroupReadyAt DateTime? // set once the Nexconn group exists
  visibility          Visibility          @default(public)
  memberCount         Int                 @default(0) // changed only in the join transaction
  createdById         String?
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  memberships         LectureMembership[]
  moments             Moment[]

  // Never findUnique/upsert/update/delete by youtubeId: Prisma drops the predicate and can
  // return a private row. Use findFirst({ where: { youtubeId, visibility: "public" } }).
  @@unique([youtubeId], map: "lectures_public_youtubeId_key", where: { visibility: "public" })
  @@index([visibility, memberCount(sort: Desc), createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@map("lectures")
}

model LectureMembership {
  lectureId       String
  userId          String
  role            Role      @default(member)
  joinedAt        DateTime  @default(now())
  nexconnJoinedAt DateTime? // set once the user is in the Nexconn group
  lecture         Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([lectureId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("lecture_memberships")
}

enum MomentStatus {
  open
  resolved
}

enum SendStatus {
  pending
  sent
  failed
}

model Moment {
  id               String       @id // 32 letters and digits
  lectureId        String
  userId           String? // null once the author's account is deleted
  clientId         String // the browser's temporary ID; makes a retried POST idempotent
  tSec             Int // whole seconds into the video
  body             String
  parentId         String? // replies (threads land on Day 6)
  status           MomentStatus @default(open)
  upvotes          Int          @default(0)
  pinnedAt         DateTime?
  pinnedById       String?
  nexconnMessageId String?
  sendStatus       SendStatus   @default(pending) // Postgres is the truth; Nexconn is the live signal
  sendAttempts     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lecture          Lecture      @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user             User?        @relation("MomentAuthor", fields: [userId], references: [id], onDelete: SetNull)
  pinnedBy         User?        @relation("MomentPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  parent           Moment?      @relation("MomentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Moment[]     @relation("MomentReplies")

  @@unique([userId, clientId])
  @@index([lectureId, tSec])
  @@index([parentId])
  @@index([lectureId, sendStatus])
  @@map("moments")
}
